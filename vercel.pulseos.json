{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:pulseos",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/course-builder",
      "destination": "/course-builder/index.html"
    },
    {
      "source": "/competency-library",
      "destination": "/competency-library/index.html"
    },
    {
      "source": "/role-builder",
      "destination": "/role-builder/index.html"
    },
    {
      "source": "/ojt-compliance",
      "destination": "/ojt-compliance/index.html"
    },
    {
      "source": "/construction-workforce-readiness",
      "destination": "/construction-workforce-readiness/index.html"
    },
    {
      "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ojt-workspace",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/foreman",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/course-builder/assessments",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/course-builder/analytics",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/pulseos",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
